{
  "name": "pve-lite-dashboard",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "lint": "eslint src tests vite.config.ts --quiet",
    "typecheck": "vue-tsc --noEmit",
    "test:unit": "vitest run --config tests/vitest.config.ts",
    "test:e2e": "playwright test --config tests/playwright.config.ts",
    "test:visual": "playwright test --config tests/playwright.config.ts tests/e2e/visual.spec.ts",
    "test:visual:update": "playwright test --config tests/playwright.config.ts tests/e2e/visual.spec.ts --update-snapshots",
    "verify": "npm run lint && npm run typecheck && npm run test:unit && npm run build && npm run test:e2e"
  },
  "dependencies": {
    "pinia": "^3.0.0",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.50.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "@types/node": "^22.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "eslint-plugin-vue": "^10.0.0",
    "globals": "^15.0.0",
    "jsdom": "^26.0.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0",
    "vue-eslint-parser": "^10.0.0",
    "vue-tsc": "^2.2.0"
  }
}
